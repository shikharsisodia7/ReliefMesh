RELIEFMESH_APP_ENV=production
RELIEFMESH_STORAGE_MODE=mongo
RELIEFMESH_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
RELIEFMESH_MONGODB_DATABASE=reliefmesh
RELIEFMESH_JWT_SECRET=replace-with-a-32-byte-or-longer-random-secret
RELIEFMESH_FRONTEND_ORIGIN=https://your-reliefmesh.vercel.app
RELIEFMESH_CORS_ORIGINS=["https://your-reliefmesh.vercel.app"]
RELIEFMESH_PUBLIC_API_URL=https://your-reliefmesh-api.onrender.com
RELIEFMESH_RESEND_API_KEY=
# Must be on a domain verified in Resend (see docs/EMAIL_DOMAIN.md); the key below must allow that domain.
RELIEFMESH_EMAIL_FROM=ReliefMesh Procurement <procurement@reliefmesh.us>
RELIEFMESH_EXPOSE_INVITATION_LINKS=false
# Development/test only: seeded TEST suppliers + simulated disruptions. Production refuses to start with true.
RELIEFMESH_DEMO_MODE=false

# Public data (keyless sources need nothing: EONET, NWS, OpenFEMA, OFAC, USAspending, openFDA)
RELIEFMESH_NASA_FIRMS_MAP_KEY=
RELIEFMESH_SAM_GOV_API_KEY=

# Sponsors
RELIEFMESH_APIFY_API_TOKEN=
RELIEFMESH_CRS_USERNAME=
RELIEFMESH_CRS_PASSWORD=
RELIEFMESH_CRS_BASE_URL=https://api-sandbox.stitchcredit.com/api
RELIEFMESH_NESSIE_API_KEY=
RELIEFMESH_ELASTIC_URL=
RELIEFMESH_ELASTIC_API_KEY=
RELIEFMESH_ANTHROPIC_API_KEY=
RELIEFMESH_GEMINI_API_KEY=
RELIEFMESH_AGENT_PRIVILEGED_SENDERS=[]

# x402 on Solana DEVNET (test USDC only)
RELIEFMESH_X402_PAY_TO=
RELIEFMESH_X402_BUYER_PRIVATE_KEY=
RELIEFMESH_X402_TREASURY_PRIVATE_KEY=
RELIEFMESH_X402_FACILITATOR_URL=https://x402.org/facilitator
RELIEFMESH_X402_PRICE_USD=0.01
RELIEFMESH_X402_DAILY_CAP_USD=0.10
