RELIEFMESH_APP_ENV=production
RELIEFMESH_STORAGE_MODE=mongo
RELIEFMESH_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
RELIEFMESH_MONGODB_DATABASE=reliefmesh
RELIEFMESH_JWT_SECRET=replace-with-a-32-byte-or-longer-random-secret
RELIEFMESH_FRONTEND_ORIGIN=https://your-reliefmesh.vercel.app
RELIEFMESH_CORS_ORIGINS=["https://your-reliefmesh.vercel.app"]
RELIEFMESH_RESEND_API_KEY=re_your_resend_api_key
RELIEFMESH_EMAIL_FROM=ReliefMesh <rfq@your-verified-domain.example>
RELIEFMESH_EXPOSE_INVITATION_LINKS=false
